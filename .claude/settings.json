{
  "permissions": {
    "allow": [
      "Bash(gh issue:*)",
      "Bash(gh api:*)",
      "Bash(gh label:*)",
      "Bash(gh pr:*)",
      "Bash(git:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)"
    ]
  }
}
